# Build stage
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git protobuf-dev

WORKDIR /app

# Cache module downloads
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the engine binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o engine ./cmd/engine

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /app/engine .
# Migrations are also shipped so an operator can run them from the engine
# container if needed (see docker-compose `migrate` service).
COPY --from=builder /app/migrations ./migrations

EXPOSE 50051 9090

CMD ["./engine"]
