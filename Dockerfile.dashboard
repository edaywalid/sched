# Stage 1: build the React dashboard from the pnpm workspace.
FROM node:22-alpine AS web
ENV CI=true
WORKDIR /web
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
COPY web/ ./
RUN pnpm install --frozen-lockfile && pnpm --filter @sched/dashboard build

# Stage 2: compile the Go binary with the React bundle embedded.
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /web/apps/dashboard/dist/ ./cmd/dashboard/web_dist/
RUN CGO_ENABLED=0 GOOS=linux go build -o /dashboard ./cmd/dashboard

# Stage 3: tiny runtime image.
FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /dashboard .
EXPOSE 8080
CMD ["./dashboard"]
